{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GanttChartSpec",
  "description": "Render a Gantt chart: tasks, phases or goals on a calendar, with progress, milestones and dependencies.",
  "type": "object",
  "required": [
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title, sentence case. Say what is measured."
    },
    "subtitle": {
      "type": "string",
      "description": "Optional context: units, period, or the takeaway."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "start"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Referenced by dependsOn. Defaults to name."
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "ISO date, e.g. 2026-03-01."
          },
          "end": {
            "type": "string",
            "description": "ISO date. Or use durationDays. Omit both for a milestone."
          },
          "durationDays": {
            "type": "number",
            "minimum": 0
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "0–1 or 0–100."
          },
          "group": {
            "type": "string",
            "description": "Tasks in a group share a colour (≤4 groups coloured)."
          },
          "milestone": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ids or names of tasks that must finish first."
          }
        }
      }
    },
    "groupColors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "purple",
          "teal",
          "orange",
          "blue",
          "neutral"
        ]
      },
      "description": "Pin colours by group name."
    },
    "today": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Today rule: true/false or an ISO date. Default: shown when in range."
    },
    "markers": {
      "type": "array",
      "description": "Dated rules, e.g. a deadline.",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "labels": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "progress",
        "duration",
        "dates"
      ],
      "default": "auto",
      "description": "Text after each bar."
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "emptyMessage": {
      "type": "string"
    }
  }
}
