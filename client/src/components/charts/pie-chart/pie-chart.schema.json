{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PieChartSpec",
  "description": "Render a donut/pie showing how ONE whole splits into a few parts, read at a glance. Max 4 coloured slices; the rest fold into grey \"Other\". Do NOT use to compare close values, rank many parts, or show change over time — use a bar chart. Avoid 2-slice pies.",
  "type": "object",
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title, sentence case. Say what is measured."
    },
    "subtitle": {
      "type": "string",
      "description": "Optional context: units, period, or the takeaway."
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "string",
            "enum": [
              "purple",
              "teal",
              "orange",
              "blue",
              "neutral"
            ]
          }
        }
      }
    },
    "donut": {
      "type": "boolean",
      "default": true,
      "description": "Ring with the total in the centre."
    },
    "center": {
      "type": "object",
      "additionalProperties": false,
      "description": "Override the centre text (default: total).",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "sort": {
      "type": "string",
      "enum": [
        "desc",
        "none"
      ],
      "default": "desc"
    },
    "valueFormat": {
      "type": "object",
      "additionalProperties": false,
      "description": "How numbers are printed.",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "number",
            "currency",
            "percent"
          ],
          "default": "number",
          "description": "percent means values are already percentages (45 = 45%)."
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 code, default USD."
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "compact": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            true,
            false,
            "auto"
          ],
          "default": "auto",
          "description": "12.4K / $1.2M notation. auto compacts at 10,000+."
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string",
          "description": "Unit suffix, e.g. \" hrs\"."
        }
      }
    },
    "minSharePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "Slices below this share fold into Other."
    },
    "emptyMessage": {
      "type": "string"
    }
  }
}
