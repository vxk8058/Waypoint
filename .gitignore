# Repo-wide ignores. client/.gitignore covers frontend-specific files.

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# Python (if a backend is added)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local Claude Code settings
.claude/settings.local.json
